{
  "name": "Knew Knowledge editor",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-bookworm",
  "postCreateCommand": "BUNDLE_GEMFILE=.devcontainer/Gemfile bundle install",
  "postAttachCommand": {
    "preview": "BUNDLE_GEMFILE=.devcontainer/Gemfile bundle exec jekyll serve --host 0.0.0.0 --port 4000 --baseurl ''"
  },
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Your private site preview",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["EDITING.md", "_data/home.yml"]
    }
  }
}
